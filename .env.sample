SECRET_KEY=changeme-generate-a-real-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app

DATABASE_URL=sqlite:///db.sqlite3
# Production (Supabase) — use the "Transaction" pooler connection string
# (Project Settings > Database > Connection string > Transaction pooler,
# port 6543). Required for Vercel's serverless functions — the direct
# connection (port 5432) is IPv6-only and Vercel's functions can't reach it.
# DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

ORS_API_KEY=your-openrouteservice-api-key
ORS_BASE_URL=https://api.openrouteservice.org
